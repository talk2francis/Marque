    "@marque/db": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "@marque/chain": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "react": "^19",
    "wagmi": "^2.14.11",
    "@wagmi/core": "^2.16.0"
  }
