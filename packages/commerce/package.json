{
  "name": "@marque/commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./state": "./src/state.ts",
    "./errors": "./src/errors.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "codegen": "tsx scripts/codegen.mts"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.6.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1",
