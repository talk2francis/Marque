                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters."
          },
          "429": {
            "description": "Client request limit reached. Retry-After states the wait when provided."
          },
          "503": {
            "description": "The projection is unavailable; this is not an empty successful result."
          }
        }
      }
    },
