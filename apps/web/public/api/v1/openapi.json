    "/api/v1/recheck": {
      "post": {
        "operationId": "recheckAnswer",
        "summary": "Compare a recorded answer with current chain state",
        "description": "Read-only. Maximum 512 bytes; 20 requests per client per minute; four-second deadline; cached up to 60 seconds. Uses existing category readers and tolerances. Never writes lens_result. Security reviews have no live recheck. The observation network is explicitly returned (BSC mainnet even for a practice job).",
        "tags": [
          "Workspace"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chainId",
                  "jobId"
                ],
                "properties": {
                  "chainId": {
                    "type": "integer",
                    "enum": [
                      56,
                      97
                    ]
                  },
                  "jobId": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,11}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
