{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marque.trade/api/v1/schemas/catalog.v1.json",
  "description": "Structural contract. Runtime cross-field, freshness, commitment and exact-selection checks remain required; schema validation is not signing permission.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "marque.catalog.v1"
    },
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceComputedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "const": "MEASURED_PROJECTION"
    },
    "sourceAgeMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "page": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "population": {
          "const": "FILTERED_DEDUPLICATED_MARKETPLACE_ENTRIES"
        }
      },
      "required": [
        "count",
        "total",
        "offset",
        "limit",
        "hasMore",
        "nextOffset",
        "population"
      ],
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "maxLength": 4000
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "chainId": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "const": 56
                      },
                      {
                        "const": 97
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tokenId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,77})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "registrationIsQualityProof": {
                "const": false
              }
            },
            "required": [
              "chainId",
              "tokenId",
              "registrationIsQualityProof"
            ],
            "additionalProperties": true
          },
          "ownership": {
            "type": "object",
            "properties": {
              "owner": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[\\da-fA-F]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "firstParty": {
                "type": "boolean"
              },
              "identityCount": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "const": "INDEXED_AND_CONFIGURED"
              },
              "freshness": {
                "const": "NOT_RECHECKED_ONCHAIN"
              },
              "humanAndFundingIndependence": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "owner",
              "firstParty",
              "identityCount",
              "source",
              "freshness",
              "humanAndFundingIndependence"
            ],
            "additionalProperties": true
          },
          "discovery": {
            "type": "object",
            "properties": {
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                },
                "maxItems": 30
              },
              "protocols": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                },
                "maxItems": 30
              },
              "source": {
                "const": "INDEXED_DECLARATIONS"
              }
            },
            "required": [
              "interfaces",
              "protocols",
              "source"
            ],
            "additionalProperties": true
          },
          "selectedService": {
            "type": "object",
            "properties": {
              "serviceId": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "chainId": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "const": 56
                      },
                      {
                        "const": 97
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provider": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[\\da-fA-F]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transport": {
                "const": "UNKNOWN_IN_EXISTING_PROJECTION"
              },
              "inventoryScope": {
                "const": "ONE_SELECTED_COMMERCIAL_SERVICE_PER_ENTRY"
              },
              "exactTaskSupport": {
                "const": "UNKNOWN_REQUEST_EXACT_TASK_QUOTE"
              }
            },
            "required": [
              "serviceId",
              "chainId",
              "provider",
              "transport",
              "inventoryScope",
              "exactTaskSupport"
            ],
            "additionalProperties": true
          },
          "payableRails": {
            "type": "object",
            "properties": {
              "erc8183": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "CANDIDATE_REQUIRES_FRESH_QUOTE",
                      "UNAVAILABLE"
                    ]
                  },
                  "failure": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "state",
                  "failure"
                ],
                "additionalProperties": true
              },
              "x402": {
                "type": "object",
                "properties": {
                  "discovered": {
                    "type": "boolean"
                  },
                  "buyerSupport": {
                    "const": "UNSUPPORTED"
                  }
                },
                "required": [
                  "discovered",
                  "buyerSupport"
                ],
                "additionalProperties": true
              },
              "a2aAndMcp": {
                "const": "DISCOVERY_TRANSPORTS_NOT_PAYMENT_RAILS"
              }
            },
            "required": [
              "erc8183",
              "x402",
              "a2aAndMcp"
            ],
            "additionalProperties": true
          },
          "price": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "CURRENT",
                  "EXPIRED",
                  "UNKNOWN"
                ]
              },
              "amountRaw": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,77})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "token": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "address": {
                        "type": "string",
                        "pattern": "^0x[\\da-fA-F]{40}$"
                      },
                      "symbol": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "decimals": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    },
                    "required": [
                      "address",
                      "symbol",
                      "decimals"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "chainId": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "const": 56
                      },
                      {
                        "const": 97
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quoteMode": {
                "type": "string",
                "enum": [
                  "provider_signed",
                  "identity_matched_unsigned",
                  "unknown"
                ]
              },
              "provenance": {
                "const": "STORED_QUOTE_OBSERVATION"
              },
              "taskBinding": {
                "const": "UNKNOWN_UNTIL_FRESH_QUOTE"
              }
            },
            "required": [
              "state",
              "amountRaw",
              "token",
              "chainId",
              "observedAt",
              "expiresAt",
              "quoteMode",
              "provenance",
              "taskBinding"
            ],
            "additionalProperties": true
          },
          "observation": {
            "type": "object",
            "properties": {
              "liveness": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latencyMs": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sampleTime": {
                "type": "null"
              },
              "recency": {
                "const": "EXACT_PROBE_TIME_NOT_IN_EXISTING_PROJECTION"
              }
            },
            "required": [
              "liveness",
              "latencyMs",
              "sampleTime",
              "recency"
            ],
            "additionalProperties": true
          },
          "conformance": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "IDENTITY_TEST_PASSED",
                  "IDENTITY_TEST_FAILED",
                  "UNTESTED"
                ]
              },
              "testId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exactServiceBinding": {
                "const": "UNKNOWN"
              },
              "paymentProof": {
                "const": "NOT_IMPLIED"
              }
            },
            "required": [
              "state",
              "testId",
              "observedAt",
              "exactServiceBinding",
              "paymentProof"
            ],
            "additionalProperties": true
          },
          "links": {
            "type": "object",
            "properties": {
              "hireMetadata": {
                "type": "string"
              },
              "profile": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "hireMetadata",
              "profile"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "agentId",
          "name",
          "category",
          "identity",
          "ownership",
          "discovery",
          "selectedService",
          "payableRails",
          "price",
          "observation",
          "conformance",
          "links"
        ],
        "additionalProperties": false
      },
      "maxItems": 300
    },
    "cacheMaxAgeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "version",
    "generatedAt",
    "sourceComputedAt",
    "provenance",
    "sourceAgeMs",
    "stale",
    "page",
    "agents",
    "cacheMaxAgeSeconds",
    "limitations"
  ],
  "additionalProperties": false
}
