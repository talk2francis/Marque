{
  "name": "marque",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @marque/web build",
    "dev": "pnpm --filter @marque/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "db:generate": "pnpm --filter @marque/db generate",
    "db:migrate": "pnpm --filter @marque/db migrate",
    "supply-report": "tsx scripts/supply-report.mts",
    "mcs": "tsx scripts/mcs.mts",
    "standard": "tsx scripts/generate-standard.mts",
    "hire": "tsx scripts/hire.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@marque/chain": "workspace:*",
    "@marque/conformance": "workspace:*",
    "@marque/db": "workspace:*",
    "@marque/positions": "workspace:*",
    "@marque/probe": "workspace:*",
    "@marque/registry": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.38.2",
    "eslint": "^9.17.0",
    "marked": "^18.0.11",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "@marque/execution": "workspace:*"
  }
}