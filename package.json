{
  "name": "marque",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @marque/web build",
    "dev": "pnpm --filter @marque/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "db:generate": "pnpm --filter @marque/db generate",
    "db:migrate": "pnpm --filter @marque/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "@eslint/js": "^9.17.0",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
